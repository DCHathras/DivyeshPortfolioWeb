@{
    ViewData["Title"] = "Skills";
}

<section class="page-hero page-width">
    <p class="eyebrow"><span class="eyebrow-line"></span> Tools of the trade</p>
    <h1>Fluent in the<br /><span>whole stack.</span></h1>
    <p class="page-hero-copy">Technologies and practices used to build intelligent, production-ready applications.</p>
</section>

<section class="section page-width skills-page-section">
    <div class="skill-category reveal">
        <div class="skill-category-heading"><span>01</span><h2>Backend engineering</h2><p>Services, APIs, and application architecture.</p></div>
        <div class="skill-category-content">
            <div class="skill-detail"><span>C# Programming</span><p>OOP, LINQ, Async/Await</p></div>
            <div class="skill-detail"><span>ASP.NET Core MVC</span><p>MVC, Razor, Middleware</p></div>
            <div class="skill-detail"><span>Web API</span><p>REST API, Authentication</p></div>
            <div class="skill-detail"><span>ADO.NET</span><p>Database querying</p></div>
            <div class="skill-detail"><span>LINQ</span><p>Querying databases using C#</p></div>
            <div class="skill-detail"><span>Design Patterns</span><p>Reducing code clutter</p></div>
            <div class="skill-detail"><span>ASP.NET Core</span><p>.NET 6/8/9/10, EF Core, Dapper</p></div>
        </div>
    </div>
    <div class="skill-category reveal">
        <div class="skill-category-heading"><span>02</span><h2>Data &amp; performance</h2><p>Reliable data access and thoughtful optimization.</p></div>
        <div class="skill-category-content">
            <div class="skill-detail"><span>SQL Server</span><p>Queries, joins, database design</p></div>
            <div class="skill-detail"><span>Databases</span><p>PostgreSQL, MySQL, MongoDB, Cosmos DB</p></div>
            <div class="skill-detail"><span>Data access</span><p>Stored procedures, indexing, query optimization</p></div>
            <div class="skill-detail"><span>Caching</span><p>Redis</p></div>
        </div>
    </div>
    <div class="skill-category reveal">
        <div class="skill-category-heading"><span>03</span><h2>AI &amp; machine learning</h2><p>Making intelligent systems useful in real products.</p></div>
        <div class="skill-category-content">
            <div class="skill-detail"><span>Generative AI</span><p>LLMs, prompt engineering, OpenAI APIs</p></div>
            <div class="skill-detail"><span>Machine Learning</span><p>Python, ML fundamentals</p></div>
            <div class="skill-detail"><span>RAG architecture</span><p>Embeddings, vector search</p></div>
            <div class="skill-detail"><span>AI search</span><p>Semantic search, Azure AI Search, Qdrant</p></div>
        </div>
    </div>
    <div class="skill-category reveal">
        <div class="skill-category-heading"><span>04</span><h2>Cloud &amp; delivery</h2><p>Shipping, operating, and improving applications.</p></div>
        <div class="skill-category-content">
            <div class="skill-detail"><span>Docker</span><p>Docker images, containers, Docker Swarm</p></div>
            <div class="skill-detail"><span>Linux</span><p>Linux container deployment</p></div>
            <div class="skill-detail"><span>Cloud</span><p>Azure, AWS, cloud deployment fundamentals</p></div>
            <div class="skill-detail"><span>Git &amp; GitHub</span><p>Version control</p></div>
            <div class="skill-detail"><span>CI/CD</span><p>Azure DevOps, build and deployment workflows</p></div>
        </div>
    </div>
    <div class="skill-category reveal">
        <div class="skill-category-heading"><span>05</span><h2>Frontend &amp; integration</h2><p>Connecting people, products, and services.</p></div>
        <div class="skill-category-content">
            <div class="skill-detail"><span>Frontend</span><p>Angular, React, RxJS, JavaScript, TypeScript</p></div>
            <div class="skill-detail"><span>Web foundations</span><p>HTML5, CSS3, jQuery, Bootstrap</p></div>
            <div class="skill-detail"><span>Messaging</span><p>RabbitMQ, ActiveMQ, Amazon SQS</p></div>
            <div class="skill-detail"><span>Real-time</span><p>SignalR, WebSockets</p></div>
            <div class="skill-detail"><span>Testing &amp; security</span><p>xUnit, NUnit, Moq, JWT, OAuth 2.0, RBAC, OWASP, OSINT</p></div>
        </div>
    </div>
</section>
