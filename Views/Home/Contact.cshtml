@{
    ViewData["Title"] = "Contact";
}

<section class="page-hero page-width">
    <p class="eyebrow"><span class="eyebrow-line"></span> Let’s connect</p>
    <h1>Good work starts<br /><span>with a conversation.</span></h1>
    <p class="page-hero-copy">Have an interesting .NET or AI project? Let’s work together and build something amazing.</p>
</section>

<section class="section page-width whatsapp-contact-section" aria-labelledby="whatsapp-contact-title">
    <div class="whatsapp-contact-heading">
        <p class="eyebrow"><span class="eyebrow-line"></span> A direct line</p>
        <h2 id="whatsapp-contact-title">Let's Connect on WhatsApp</h2>
        <p>Scan the QR code to chat with me directly.</p>
    </div>
    <article class="whatsapp-qr-card reveal" aria-labelledby="whatsapp-qr-title">
        <div class="whatsapp-qr-visual">
            <img class="whatsapp-qr-image"
                 src="~/Images/whatsapp-qr.svg"
                 asp-append-version="true"
                 alt="QR code to open a WhatsApp chat with Divyesh Singh"
                 width="250"
                 height="250"
                 decoding="async" />
            <div class="whatsapp-qr-fallback" role="status" aria-live="polite" hidden>
                <strong>QR code unavailable</strong>
                <span>Use the button to open our WhatsApp chat.</span>
            </div>
        </div>
        <div class="whatsapp-qr-copy">
            <p class="whatsapp-qr-kicker">WhatsApp</p>
            <h3 id="whatsapp-qr-title">Scan Me!</h3>
            <p>Chat with me on WhatsApp</p>
            <a class="whatsapp-send-button"
               href="https://wa.me/919997443174"
               target="_blank"
               rel="noopener noreferrer">
                Send Message <span aria-hidden="true">↗</span>
            </a>
        </div>
    </article>
</section>

<section class="section page-width contact-page">
    <div class="contact-page-note reveal">
        <p class="eyebrow"><span class="eyebrow-line"></span> Available for a conversation</p>
        <h2>Let’s work<br /><span>together</span><span>.</span></h2>
        <p>Reach out directly by email or phone. I’d be glad to hear about what you’re building.</p>
    </div>
    <div class="contact-details reveal">
        <a class="contact-detail" href="mailto:chaudharyhathras33@gmail.com"><span>Email</span><strong>chaudharyhathras33@gmail.com</strong><span class="contact-arrow" aria-hidden="true">↗</span></a>
        <a class="contact-detail" href="tel:+919997443174"><span>Phone</span><strong>+91 99974 43174</strong><span class="contact-arrow" aria-hidden="true">↗</span></a>
        
        <div class="contact-detail"><span>Location</span><strong>Mursan, Hathras, India</strong><span class="contact-arrow" aria-hidden="true">⌖</span></div>
        <div class="contact-detail"><span>Specialization</span><strong>.NET AI Development</strong><span class="contact-arrow" aria-hidden="true">✳</span></div>
        <div class="contact-socials">
            <a href="https://github.com/DCHathras/" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
